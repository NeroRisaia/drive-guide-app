{"points":[[3550352,13458177,"西ヶ岡の棚田",0,"","","n9891862101"],[3550506,13467328,"",3,"","蘇武岳方面を望める展望台。ここから見える万場スキー場や奥神鍋スキー場は地すべり地の緩斜面を利用している。蘇武岳周辺は日本海拡大期後期に海の中にたまった泥岩が分布しており、これが地すべりの原因となっている。柔らかい泥岩からなるにもかかわらず山地になっているのは、この泥岩に背骨のように火山岩が入り込み、崩れるのを防いでいるからだと考えられる。","n10153871614"],[3552339,13469124,"狗留尊仏",0,"","","n9591648637"],[3559314,13461132,"Kasumitsu Winery",0,"","","n701885198"],[3562362,13462564,"大乗寺円山派古画展覧場",1,"","","n1423057501"],[3564833,13463889,"香美町海の文化館",1,"香美町立ジオパークと海の文化館","","n1423093523"],[3564919,13455834,"余部鉄橋「空の駅」",0,"","","n9355429947"],[3564929,13455867,"",3,"","","n9355429942"],[3565172,13457557,"",3,"","","n9350581332"],[3565968,13473859,"はさかり岩",0,"はさかり岩","","n5584069384"],[3566094,13464848,"大引の鼻展望台",3,"","","w830219042"]]}