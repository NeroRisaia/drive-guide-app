","","n10858037378"],[3294752,13207139,"水の子灯台　段々展望所",3,"","","w921109528"],[3295022,13254914,"南レク馬瀬山公園 紫電改展示館",1,"","紫電改展示館を訪れる上で、廃止された御荘湾ロープウェイが存在した時代は、最寄りのバス停が南レク御荘公園前だった。現在、宇和島バスを下車する場合、最寄りは平城札所前となる。下車後、御荘平城地区から展示館まで登ってくるために、愛媛県道32号線（平城高茂岬線）を使うことになる。これは自動車専用規格で建設された元の西海有料道路であるため、路肩に歩道が存在せず、歩行者が通行するのは危険である。また、傾斜がかなり急であるため、タクシーか道の駅みしょうMICでレンタル電動アシスト付き自転車を予約するのを検討されたい。","w1057602041"],[3295052,13255224,"南レク馬瀬山公園こども動物園",4,"","","w1057593618"],[3296497,13265847,"",3,"","","w1220538000"],[3296772,13265776,"愛南町一本松郷土資料館",1,"","","w690593044"],[3298948,13291525,"四万十川学遊館",1,"","","w549286487"],[3299694,13293062,"四万十市立郷土資料館",1,"","","n1423731922"]]}